t-editorial_editorialContent__RCW3z\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--section-heading-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-4__NfPIh heading_heading-lg-3__m424S\">Take control of your personal information.</h2><p class=\"text_text__fuyHD text_text-md__T0D6z text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-md__rH1du text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">The DuckDuckGo browser is designed for data protection, not data collection. Our<!-- --> <a href=\"https://duckduckgo.com/compare-privacy\" rel=\"noopener noreferrer\" target=\"_blank\">browsing protections</a>, such as ad tracker blocking and cookie blocking, help stop your data from being collected. And our built-in search engine never tracks your searches. Available on<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/get-duckduckgo/get-duckduckgo-browser-on-mac/\" rel=\"noopener noreferrer\" target=\"_blank\">Mac</a>,<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/get-duckduckgo/get-duckduckgo-browser-on-windows/\" rel=\"noopener noreferrer\" target=\"_blank\">Windows</a>,<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/mobile/ios/\" rel=\"noopener noreferrer\" target=\"_blank\">iOS</a>, and<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/mobile/android/\" rel=\"noopener noreferrer\" target=\"_blank\">Android</a>.</p></div></div></div></div></section><section class=\"about-stories_stories__ETdLc\"><div class=\"about-stories_inner__YVJMl\"><div><div class=\"timeline_timelineContainer__x5lZL\" aria-hidden=\"true\"><div class=\"timeline_timelinePictogram__OnDiO\"><img src=\"/_next/static/media/calendar.29bde6ca.svg\" alt=\"\"/></div><div class=\"timeline_timelineScroller__y32Pm\"><div class=\"timeline_timelineWrapper__f1RNZ\"><button tabindex=\"-1\" class=\"timeline_active__dQT3M\" aria-label=\" Our Story of Protection\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" We Hatched\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Launch!\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2010 Anonymous\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2010</span></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2011 The Billboard\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2011</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" Launched Charitable Donations Program\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Team Member #1\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Headquarters\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2012 Redesign\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2012</span></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2013 1 Billion Searches!\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2013</span></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2014 Team Member #10\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2014</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" Reimagined\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Safari\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Firefox\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2016 10 Billion Searches!\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2016</span></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2018 Privacy Beyond Search\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2018</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" $1 Million Donation Milestone\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2020 50 Billion Searches!\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2020</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" Team Member #100\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2022 100 Billion Searches!\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2022</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" Privacy on Mac\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Email Protection\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2023 Privacy on Windows\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2023</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" 15th Anniversary!\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2024 Private Sync &amp; Backup\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2024</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" DuckDuckGo Subscription\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Duck.ai\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" Investments\"></button><button tabindex=\"-1\" class=\"\" aria-label=\" $6M Mark in Charitable Donations\"></button><button tabindex=\"-1\" class=\"timeline_hasYear__rLJ5O\" aria-label=\"2025 Subscription + Duck.ai\"><span class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">2025</span></button><button tabindex=\"-1\" class=\"\" aria-label=\" $8M Mark in Charitable Donations\"></button><div class=\"timeline_spacer__2u6UW\"> </div></div></div></div><div class=\"flex-grid\" role=\"group\" aria-roledescription=\"carousel\" aria-label=\"Our Story\"><div class=\"col-1\"></div><div class=\"col-14 timeline_mainContainer__3ktMg\"><div class=\"timeline_carouselRow__K9zAo\"><button aria-label=\"Previous slide\" class=\"timeline_arrow__cRdqZ\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" aria-hidden=\"true\"><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M15.78 3.22a.75.75 0 0 0-1.06 0l-7.013 7.012a2.5 2.5 0 0 0 0 3.536l7.138 7.137a.75.75 0 1 0 1.06-1.06l-7.137-7.138a1 1 0 0 1 0-1.414L15.78 4.28a.75.75 0 0 0 0-1.06Z\" clip-rule=\"evenodd\"></path></svg></button><div class=\"timeline_slideContainer__lm7Z9\"><div class=\"timeline_innerScroll___ehnK\" aria-atomic=\"false\" aria-live=\"polite\"><span style=\"border:0;clip:rect(0 0 0 0);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;white-space:nowrap;word-wrap:normal\" role=\"group\" aria-roledescription=\"slide\" aria-labelledby=\"_R_156_\"><h2 id=\"_R_156_\">Our Story of Protection</h2><p>Since 2008, we’ve expanded what we do to protect you no matter where you go on the Internet. Check out our story.</p><p></p><p>1<!-- --> of <!-- -->31</p></span><article aria-hidden=\"true\" class=\"timeline_story__usk0H timeline_active__dQT3M\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Our Story of Protection</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Since 2008, we’ve expanded what we do to protect you no matter where you go on the Internet. Check out our story.</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">We Hatched</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">DuckDuckGo began as an idea for a better search engine experience. We hatched out of a few servers in a dusty basement.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">September 25, 2008</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Launch!</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Within the year, DuckDuckGo was announced to the Hacker News and reddit communities. We made it out with only minor troll scars.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">September 25, 2008</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Anonymous</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We decided to make a bold move and not track your search history. Tracking is creepy.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">March 15, 2010</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">The Billboard</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We told the world “Google tracks you. We don’t.” with a billboard in their backyard. Hello, World!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">January 11, 2011</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Launched Charitable Donations Program</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We rely on a lot of great projects to keep our wings flapping. So we started giving back to support new and innovative tech projects, strengthening our commitment to raising the standard of trust online.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">February 26, 2011</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Team Member #1</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">For years, our founder Gabriel was the only full-timer. Caine Tighe changed all that, coming on board as our first official team member.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">November 30, 2011</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Headquarters</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We finally moved out of Gabriel’s basement into our fortress in Paoli, PA. It really looks like a castle!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">December 1, 2011</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Redesign</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Our first major visual overhaul introduced a new design that made you not want to close your browser the second you saw our results page.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">January 16, 2012</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">1 Billion Searches!</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We reached the incredible milestone of 1 billion anonymous searches.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">July 18, 2013</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Team Member #10</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">The big guys have thousands more team members than us, and so everyone at DuckDuckGo is an essential member of the team. Welcome to our 10th team member!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">March 17, 2014</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Reimagined</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">DuckDuckGo launches a redesigned search engine with a refined look and a focus on smarter answers. And, of course, we still don’t track you.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">May 19, 2014</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Safari</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Apple begins including DuckDuckGo in Safari, with the launch of iOS 8 and OS X Yosemite. Wow, cool!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">September 17, 2014</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Firefox</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Mozilla adds DuckDuckGo as a built-in search option to Firefox. Thank you! Do you think we’ll ever get into Chrome?</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">November 10, 2014</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">10 Billion Searches!</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We concluded 2016 with over four billion anonymous searches served, surpassing a cumulative count of ten billion!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">December 31, 2016</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Privacy Beyond Search</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We extended our privacy protection beyond the search box with the launch of our new mobile app &amp; browser extension, available on all major platforms.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">January 23, 2018</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">$1 Million Donation Milestone</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We reached $1 million in donations to help support organizations that share our vision to raise the standard of trust online.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">April 10, 2018</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">50 Billion Searches!</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">In the last two years, we&#x27;ve flown from 25 billion searches to a whopping 50 billion!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">June 20, 2020</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Team Member #100</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">The pond’s getting fuller! With our 100th team member joining the flock, we’re adding more quack to our team spirit.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">July 1, 2020</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">100 Billion Searches!</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Over the past one and a half years, we’ve doubled our all-time searches to 100 billion!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">January 13, 2022</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Privacy on Mac</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We brought our browser experience to desktops and laptops with the launch of the DuckDuckGo Private Browser on Mac.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">April 12, 2022</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Email Protection</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We launched<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/email-protection/\">Email Protection</a> <!-- -->— our free email forwarding service that removes multiple types of hidden email trackers and lets you create private email addresses on the fly.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">August 25, 2022</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Privacy on Windows</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We launched the DuckDuckGo Private Browser on Windows.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">June 22, 2023</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">15th Anniversary!</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We celebrated 15 years of DuckDuckGo, now offering comprehensive privacy protections used by tens of millions of people to protect their everyday online activities, from searching to browsing, emailing, and more. </p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">September 25, 2023</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Private Sync &amp; Backup</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We introduced the ability to privately and securely<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/sync-and-backup/\">sync and backup</a> <!-- -->bookmarks, passwords, and<!-- --> <a href=\"https://duckduckgo.com/duckduckgo-help-pages/email-protection/\">Email Protection</a> <!-- -->settings between DuckDuckGo browsers on phones, tablets, and computers.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">February 15, 2024</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">DuckDuckGo Subscription</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We launched the<!-- --> <a href=\"https://duckduckgo.com/pro\">DuckDuckGo subscription</a> (formerly Privacy Pro) — our subscription service with VPN, Personal Information Removal, and Identity Theft Restoration!</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">April 11, 2024</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Duck.ai</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We launched <a href=\"https://duck.ai\">Duck.ai</a> — a private way to access popular AI chatbots.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">June 6, 2024</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Investments</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We announced we&#x27;re<!-- --> <a href=\"https://spreadprivacy.com/duckduckgo-investing/\">investing in privacy-respecting companies</a> <!-- -->that are raising the standard of trust online.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">October 23, 2024</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">$6M Mark in Charitable Donations</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">To date, we’ve donated a total of $6.9 million in donations, reflecting our ongoing dedication to supporting organizations and raising the standard of trust online.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">December 3, 2024</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">Subscription + Duck.ai</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">We added a new benefit to the DuckDuckGo subscription — support for advanced AI models in Duck.ai.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">August 27, 2025</p></div></div></article><article aria-hidden=\"true\" class=\"timeline_story__usk0H\"><div class=\"center_root___q8wn center_andText__q9Qi5\" style=\"--center-measure:60ch\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--story-stack-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-3__adlO2 heading_heading-lg-3__m424S\">$8M Mark in Charitable Donations</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">For our fifteenth year of donations, we donated $1.1M to benefit 29 organizations that share our vision of raising the standard of trust online.</p><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">September 30, 2025</p></div></div></article></div></div><button aria-label=\"Next slide\" class=\"timeline_arrow__cRdqZ\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"none\" aria-hidden=\"true\"><path fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M8.22 3.22a.75.75 0 0 1 1.06 0l7.013 7.012a2.5 2.5 0 0 1 0 3.536l-7.138 7.137a.75.75 0 0 1-1.06-1.06l7.137-7.138a1 1 0 0 0 0-1.414L8.22 4.28a.75.75 0 0 1 0-1.06Z\" clip-rule=\"evenodd\"></path></svg></button></div></div><div class=\"col-1\"></div></div></div></div></section><section class=\"about-blog_blog__zT8To\"><div class=\"about-blog_inner__zrHY0\"><div class=\"about-blog_blogHeader__qKC7s\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-4__NfPIh heading_heading-lg-3__m424S\">From Our Blog</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">At SpreadPrivacy.com, we publish privacy education, tips, and original research, along with DuckDuckGo news.</p></div><div class=\"about-blog-posts_cards__KYCIy\"><div class=\"card_card__lrMeJ card_primary__RqGuP card_radiusXl__uaPJD about-blog-posts_card__9x5mP about-blog-posts_skeleton__JQ2yZ\"><div class=\"about-blog-posts_image__nfxv9\"></div><div class=\"about-blog-posts_content__eZe2R\"><h3 class=\"text_text__fuyHD text_text-lg__jEDDL text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-blog-posts_title__NUG_K\">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</h3><p class=\"text_text__fuyHD text_text-xs__k4CBY text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-blog-posts_category__KTB01\">X</p></div></div><div class=\"card_card__lrMeJ card_primary__RqGuP card_radiusXl__uaPJD about-blog-posts_card__9x5mP about-blog-posts_skeleton__JQ2yZ\"><div class=\"about-blog-posts_image__nfxv9\"></div><div class=\"about-blog-posts_content__eZe2R\"><h3 class=\"text_text__fuyHD text_text-lg__jEDDL text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-blog-posts_title__NUG_K\">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</h3><p class=\"text_text__fuyHD text_text-xs__k4CBY text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-blog-posts_category__KTB01\">X</p></div></div><div class=\"card_card__lrMeJ card_primary__RqGuP card_radiusXl__uaPJD about-blog-posts_card__9x5mP about-blog-posts_skeleton__JQ2yZ\"><div class=\"about-blog-posts_image__nfxv9\"></div><div class=\"about-blog-posts_content__eZe2R\"><h3 class=\"text_text__fuyHD text_text-lg__jEDDL text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-blog-posts_title__NUG_K\">XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX</h3><p class=\"text_text__fuyHD text_text-xs__k4CBY text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-blog-posts_category__KTB01\">X</p></div></div></div></div></section><section class=\"about-hiring_hiring__jM9AT\"><div class=\"about-hiring_inner__Nu3aW\"><div class=\"about-hiring_hiringInner__0yZVC\"><div class=\"about-hiring_hiringContent__d3vtS\"><div class=\"stack_root__raz5U\" style=\"--gap-size:var(--section-heading-gap)\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-4__NfPIh heading_heading-lg-3__m424S\">We&#x27;re Hiring</h2><p class=\"text_text__fuyHD text_text-md__T0D6z text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-sm__xUEDi text_text-lg-md__rH1du text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">DuckDuckGo is a remote company of passionate people from over 15 countries. Join our fully distributed team and help raise the standard of trust online — from anywhere!</p></div><a class=\"link-button_button__M7Ybe link-button_secondary-solid__zsfFJ link-button_size-md__uDqB9 motif-default\" target=\"_self\" href=\"/hiring\"><span class=\"link-button_buttonLabel__8h812\">Join Our Global Team</span></a></div><div aria-hidden=\"true\" class=\"about-hiring_hiringIllustration__BxJxW\"><picture><source type=\"image/avif\" srcSet=\"/static-assets/image/pages/about/career-dark.avif 1x, /static-assets/image/pages/about/career-dark@2x.avif 2x, /static-assets/image/pages/about/career-dark@3x.avif 3x\" media=\"(prefers-color-scheme: dark)\"/><source type=\"image/webp\" srcSet=\"/static-assets/image/pages/about/career-dark.webp 1x, /static-assets/image/pages/about/career-dark@2x.webp 2x, /static-assets/image/pages/about/career-dark@3x.webp 3x\" media=\"(prefers-color-scheme: dark)\"/><source srcSet=\"/static-assets/image/pages/about/career-dark.png 1x, /static-assets/image/pages/about/career-dark@2x.png 2x, /static-assets/image/pages/about/career-dark@3x.png 3x\" media=\"(prefers-color-scheme: dark)\"/><source type=\"image/avif\" srcSet=\"/static-assets/image/pages/about/career-light.avif 1x, /static-assets/image/pages/about/career-light@2x.avif 2x, /static-assets/image/pages/about/career-light@3x.avif 3x\"/><source type=\"image/webp\" srcSet=\"/static-assets/image/pages/about/career-light.webp 1x, /static-assets/image/pages/about/career-light@2x.webp 2x, /static-assets/image/pages/about/career-light@3x.webp 3x\"/><img src=\"/static-assets/image/pages/about/career-light.png\" srcSet=\"/static-assets/image/pages/about/career-light.png 1x, /static-assets/image/pages/about/career-light@2x.png 2x, /static-assets/image/pages/about/career-light@3x.png 3x\" alt=\"\" loading=\"lazy\" decoding=\"async\" width=\"544\" height=\"380\"/></picture></div></div></div></section><section class=\"about-newsletter_newsletter__i4AbT\"><div class=\"about-newsletter_inner__1MUmp\"><div class=\"about-newsletter_newsletterPanel__PxIwW\"><picture class=\"themedImage_wrapper__Q1Y7W\"><source srcSet=\"/_next/static/media/newsletter-bush-dark.19c10f6d.svg\" media=\"(prefers-color-scheme: dark)\"/><source srcSet=\"/_next/static/media/newsletter-bush-light.3b11df66.svg\" media=\"(prefers-color-scheme: light), (prefers-color-scheme: no-preference)\"/><img src=\"/_next/static/media/newsletter-bush-light.3b11df66.svg\" alt=\"\" aria-hidden=\"true\" class=\"about-newsletter_newsletterBush__0F3tL\"/></picture><div class=\"about-newsletter_newsletterInner__IgXAD\"><div class=\"newsletter-form_root__LovMm\" data-testid=\"newsletter-form\"><div class=\"stack_root__raz5U\" style=\"--gap-size:1rem\"><div class=\"about-newsletter_newsletterHeader__0_Z_g\"><h2 class=\"heading_heading__30RM7 heading_heading3__w4W1U heading_responsiveLevels__wzF1A heading_heading-xs-4__YmLfi heading_heading-sm-4__WbstY heading_heading-md-4__NfPIh heading_heading-lg-3__m424S\">Privacy tips and news, straight to your inbox.</h2><p class=\"text_text__fuyHD text_text-lg__jEDDL text_responsiveLevels__4lokw text_text-xs-md__vREY8 text_text-sm-md__cjDde text_text-md-md__XNdEN text_text-lg-lg__sQwXt text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-newsletter_newsletterDesc__THpkL\">Stay protected and informed with our privacy newsletter.<!-- --> <a href=\"https://duckduckgo.com/newsletter\" target=\"_blank\" rel=\"noreferrer\" class=\"text-nowrap\">Learn more.</a></p></div><form name=\"duckduckgo-newsletter\" class=\"newsletter-form_form__guZ3d\" method=\"post\"><div class=\"newsletter-form_formElements__r9Mf0\"><input type=\"email\" class=\"input_input__5Kgsn\" aria-errormessage=\"_R_9t6_\" required=\"\" aria-label=\"Email address\" placeholder=\"Enter your email address\" name=\"email\" value=\"\"/><button class=\"button_button__IWBae button_primary-solid__XpfKx button_size-md__6pe4i motif-default\" data-rac=\"\" type=\"submit\" tabindex=\"0\" data-react-aria-pressable=\"true\" id=\"react-aria-_R_1apt6_\"><span class=\"button_buttonLabel__3BEKj\">Subscribe</span></button></div></form><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2 about-newsletter_newsletterDisclaimer__Oekfb\">Your email address won&#x27;t be shared and you can unsubscribe at any time.</p></div></div></div></div></div></section><section class=\"about-podcast_podcast__F4IgL\"><div class=\"about-podcast_inner__LMx0w\"><div class=\"card_card___ZlNq card_elevation30__FjB1d card_radiusXl__wiOjc podcast-upsell-card_root__e4qYM about-podcast_podcastCard__MQDpd\"><img src=\"/static-assets/image/pages/app/DuckDuckGo-Podcast.svg\" alt=\"Inside DuckDuckGo podcast cover image\" class=\"podcast-upsell-card_image__BOmdz\" width=\"160\" height=\"160\"/><div class=\"podcast-upsell-card_content__iUlnu\"><h3 class=\"podcast-upsell-card_heading__5szVy heading_heading__30RM7 heading_heading6__SQ8ZB\">Hear directly from the DuckDuckGo team.</h3><a class=\"link-button_button__M7Ybe link-button_secondary-solid__zsfFJ link-button_size-sm__KyACa motif-default podcast-upsell-card_button___MZJI\" target=\"_blank\" href=\"https://insideduckduckgo.substack.com/?showWelcome=true\"><span class=\"link-button_buttonLabel__8h812\">Check Out Our Podcast</span></a><p class=\"text_text__fuyHD text_text-xs__k4CBY text_text-color-primary__MJkIv text_text-weight-normal__nldc2 podcast-upsell-card_disclaimer__RzcTG\">This links to an external site (Substack).<!-- --> <a href=\"https://substack.com/privacy\" target=\"_blank\" rel=\"noopener\">Privacy<span style=\"display:contents\" aria-hidden=\"true\"> </span>Policy</a></p></div></div></div></section><footer class=\"footer_root__8lxxr\"><div class=\"footer_footerContent__M83J5 container_root__Ycg94 container_responsive__hpeZ9\"><div><div class=\"stack_root__raz5U\" style=\"--gap-size:1.5rem\"><div class=\"flex-grid justify-between footer_footerTop__jnCjN\"><nav class=\"col-6 flex-grid flex-row\"><div class=\"col\"><h4 class=\"footer_footerHeading__KxBWz heading_heading__30RM7 heading_heading6__SQ8ZB\">Learn More</h4><ul role=\"list\"><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/about\">About DuckDuckGo</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/app\">About Our Browser</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/updates\">What’s New</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/compare-privacy\">Compare Privacy</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"https://spreadprivacy.com\">Blog</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/newsletter\">Newsletter</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"https://insideduckduckgo.substack.com/?showWelcome=true\">Podcast</a></p></li></ul></div><div class=\"col\"><h4 class=\"footer_footerHeading__KxBWz heading_heading__30RM7 heading_heading6__SQ8ZB\">Other Resources</h4><ul role=\"list\"><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"https://duckduckgo.com/duckduckgo-help-pages/\">Help</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" rel=\"noopener noreferrer\" href=\"https://www.reddit.com/r/duckduckgo/\">Community</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/hiring\">Careers</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/privacy\">Privacy Policy</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/terms\">Terms of Service</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/press\">Press Kit</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"https://duckduckgo.com/duckduckgo-help-pages/company/advertise-on-duckduckgo-search\">Advertise on Search</a></p></li><li class=\"\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\"><a class=\"footer_footerLink__A1Kmq\" href=\"/collaborations\">Collaborations</a></p></li></ul></div></nav><div class=\"col-9\"><h4 class=\"footer_aboutHeading__K4AiW heading_heading__30RM7 heading_heading6__SQ8ZB\">About DuckDuckGo</h4><div class=\"stack_root__raz5U\" style=\"--gap-size:2rem\"><p class=\"text_text__fuyHD text_text-md__T0D6z text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">At DuckDuckGo, we believe the best way to protect your personal information from hackers, scammers, and privacy-invasive companies is to stop it from being collected at all. That&#x27;s why millions of people <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"https://duckduckgo.com/compare-privacy\">choose DuckDuckGo over Chrome and other browsers</a> to search and browse online. Our built-in search engine is like Google but never tracks your searches, and our browser blocks ads, trackers, and cookies that collect your data. It also offers private, useful, and optional AI, including <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"https://duck.ai\">Duck.ai</a>, which lets you chat privately with ChatGPT, Claude, and other AIs, all in one place. Oh, and our browser is free. We make money from <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"https://duckduckgo.com/duckduckgo-help-pages/company/how-duckduckgo-makes-money/\">privacy-respecting search ads</a>, not by exploiting your data. Available to download on <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"/mac\">Mac</a>, <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"/windows\">Windows</a>, <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"https://apps.apple.com/app/duckduckgo-privacy-browser/id663592361?platform=iphone\">iOS</a>, and <a target=\"_blank\" rel=\"noopener\" class=\"footer_footerLink__A1Kmq\" href=\"https://play.google.com/store/apps/details?id=com.duckduckgo.mobile.android\">Android</a>.</p></div></div></div></div></div><div class=\"footer_footerBottom__RqMTy\"><div class=\"stack_root__raz5U\" style=\"--gap-size:2rem\"><div class=\"flex-grid justify-between\"><div class=\"col-6\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2 footer_footerCopyright__hwJkV\">© <!-- -->2026<!-- --> <a href=\"https://duckduckgo.com\">DuckDuckGo</a></p></div><div class=\"col-9\"><p class=\"text_text__fuyHD text_text-sm__8blRN text_text-color-primary__MJkIv text_text-weight-normal__nldc2\">Protection. Privacy. Peace of mind.</p></div></div></div></div></div></footer></div></main></div><script>!function(){try{RegExp(\"\",\"u\")}catch(t){var e=RegExp;(RegExp=function(t,p){return new e(t,p?p.replace(/u/g,\"\"):p)}).prototype=e.prototype,RegExp.__proto__=e}var t=Element.prototype;t.prepend||(t.prepend=function(){for(var e=0;e<arguments.length;e++){var t=arguments[e];this.insertBefore(\"object\"==typeof t?t:document.createTextNode(t),this.firstChild)}}),t.append||(t.append=function(){for(var e=0;e<arguments.length;e++){var t=arguments[e];this.appendChild(\"object\"==typeof t?t:document.createTextNode(t))}})}();</script><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"translations\":{\"locale\":\"en-US\",\"messages\":{\"lnHUNl\":[{\"type\":0,\"value\":\"We’re about\"},{\"type\":1,\"value\":\"newLine\"},{\"type\":0,\"value\":\"data\"},{\"type\":1,\"value\":\"ShieldBurstIcon\"},{\"type\":0,\"value\":\"protection,\"},{\"type\":1,\"value\":\"newLine\"},{\"type\":0,\"value\":\"not data collection.\"}],\"9rVf8I\":[{\"type\":0,\"value\":\"Learn More About DuckDuckGo\"}],\"dVMEjA\":[{\"type\":0,\"value\":\"Learn More About DuckDuckGo\"}],\"32k7NP\":[{\"type\":0,\"value\":\"Learn More\"}],\"qffLa3\":[{\"type\":0,\"value\":\"NEW\"}],\"7NUyVN\":[{\"type\":0,\"value\":\"More from DuckDuckGo\"}],\"0pHSXl\":[{\"type\":0,\"value\":\"Downloads\"}],\"aqcGw9\":[{\"type\":0,\"value\":\"Search\"}],\"avoqNl\":[{\"type\":0,\"value\":\"Other Resources\"}],\"KpnRFa\":[{\"type\":0,\"value\":\"Android Browser\"}],\"irtBA+\":[{\"type\":0,\"value\":\"Email Protection\"}],\"kovAeP\":[{\"type\":0,\"value\":\"Themes\"}],\"1//Wzy\":[{\"type\":0,\"value\":\"Settings\"}],\"F8YRUV\":[{\"type\":0,\"value\":\"Mac Browser\"}],\"Ptbguk\":[{\"type\":0,\"value\":\"Windows Browser\"}],\"amPlaq\":[{\"type\":0,\"value\":\"Browser Extensions\"}],\"XQM/H9\":[{\"type\":0,\"value\":\"iOS Browser\"}],\"k0sRjT\":[{\"type\":0,\"value\":\"Homepage\"}],\"Mt9udP\":[{\"offset\":0,\"options\":{\"one\":{\"value\":[
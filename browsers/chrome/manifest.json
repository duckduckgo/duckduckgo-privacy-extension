{
    "name": "OpenFocusd",
    "description": "__MSG_appDesc__",
    "homepage_url": "https://zshanhui.github.io/openfocusd/",
    "default_locale": "en",
    "version": "2026.10.10",
    "minimum_chrome_version": "128.0",
    "icons": {
        "16": "img/icon_16.png",
        "48": "img/icon_48.png",
        "128": "img/icon_128.png"
    },
    "manifest_version": 3,
    "action": {
        "default_icon": "img/icon_browser_action.png",
        "default_popup": "html/popup.html"
    },
    "options_page": "html/options.html",
    "background": {
        "service_worker": "public/js/background.js"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "permissions": [
        "alarms",
        "declarativeNetRequest",
        "favicon",
        "scripting",
        "storage",
        "tabs",
        "webRequest",
        "webNavigation",
        "cookies"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "/web_accessible_resources/*"
            ],
            "use_dynamic_url": true,
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "resources": [
                "/public/font/*",
                "/html/blocked.html"
            ],
            "use_dynamic_url": false,
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "smarter_encryption",
                "enabled": true,
                "path": "data/bundled/smarter-encryption-rules.json"
            },
            {
                "id": "adult_gambling",
                "enabled": false,
                "path": "data/bundled/adult-gambling-rules.json"
            }
        ]
    }
}
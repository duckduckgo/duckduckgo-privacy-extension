{
    "name": "OpenFocusd",
    "applications": {
        "gecko": {
            "id": "jid1-ZAdIEUB7XOzOJw@jetpack",
            "strict_min_version": "102.0"
        }
    },
    "homepage_url": "https://zshanhui.github.io/openfocusd/",
    "default_locale": "en",
    "version": "2026.10.10",
    "description": "Privacy, simplified. Protect your data as you search and browse: tracker blocking, smarter encryption, private search, and more.",
    "icons": {
        "16": "img/icon_16.png",
        "48": "img/icon_48.png",
        "128": "img/icon_128.png"
    },
    "manifest_version": 2,
    "browser_action": {
        "default_icon": "img/icon_browser_action.png",
        "default_popup": "html/popup.html"
    },
    "background": {
        "scripts": [
            "public/js/background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://localhost/*",
                "*://*.localhost/*"
            ],
            "match_about_blank": true,
            "all_frames": true,
            "world": "ISOLATED",
            "js": [
                "public/js/content-scripts/content-scope-messaging.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://localhost/*",
                "*://*.localhost/*"
            ],
            "match_about_blank": true,
            "all_frames": true,
            "world": "MAIN",
            "js": [
                "public/js/inject.js"
            ],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "html/options.html"
    },
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*/*",
        "webNavigation",
        "tabs",
        "storage",
        "<all_urls>",
        "alarms"
    ],
    "web_accessible_resources": [
        "/web_accessible_resources/*",
        "/public/font/*"
    ]
}